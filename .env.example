# Copy this file to `.env` and fill in both values.
# `.env` is gitignored — never commit real keys.
# The server loads this file automatically on startup (resolved relative to
# the compiled dist/index.js), so no extra flags are needed.

# Linear Personal API key (PAT).
# Generate at: Linear → Settings → Security & access → Personal API keys
# The server operates strictly within this key's owner's Linear permissions.
LINEAR_API_KEY=

# Anthropic API key.
# Create at: https://console.anthropic.com/  → API Keys
ANTHROPIC_API_KEY=
